# Written by auto_sec (role 08). auto_sec changes this file only while this line is first.
#
# The sender of auto_sec's login alerts: joins the two sensors' events for
# one login, applies the quiet list and sends one Telegram message. It
# stays up and restarts by itself; auto-sec-alert.path starts it again
# when an event waits and it is not running. When it stops or fails, a
# unit of its own says so (auto-sec-notify@.service).
[Unit]
Description=auto_sec login alerts: sender
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/sbin/auto-sec-detect send
Restart=always
RestartSec=5
ExecStopPost=-/usr/bin/systemctl --no-block start auto-sec-notify@%n.service
# It reads its settings, talks to Telegram and writes into its own two
# folders, nothing else.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/spool/auto-sec /var/lib/auto-sec/detect

[Install]
WantedBy=multi-user.target
