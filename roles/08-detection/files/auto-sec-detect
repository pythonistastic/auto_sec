def safe(value, limit=120):
    """A value from PAM or a log line, made fit to show: printable ASCII only."""
    text = "".join(c if 32 < ord(c) < 127 or c == " " else "?" for c in str(value))
    return text.strip()[:limit]


def stamp(t):
    if not t:
        return "never"
    return time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(t))


def both_times(t):
    return "%s (%s server time)" % (stamp(t), time.strftime("%H:%M:%S %Z", time.localtime(t)))


def new_id():
    try:
        with open(P(RANDOM_ID), encoding="ascii") as fh:
            got = fh.read(64).strip()
        if re.fullmatch(r"[0-9a-f-]{8,64}", got):
            return got
    except OSError:
        pass
    return os.urandom(16).hex()


