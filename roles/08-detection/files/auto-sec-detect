RE_ACCEPTED = re.compile(
    r"Accepted ([a-z][a-z0-9/-]{1,40}) for (\S{1,100}) from (\S{1,200}) port ([0-9]{1,5}) ssh2"
    r"(?:: (\S{1,40}) ((?:SHA256|MD5):\S{8,100})(?:[ ,].{0,400})?)?")
RE_PAM_OPEN = re.compile(
    r"pam_unix\(([A-Za-z0-9_.-]{1,32}):session\): session opened for user (\S{1,100}?)(?:\(uid=([0-9]{1,10})\))?"
    r" by (\S{0,100}?)\(uid=([0-9]{1,10})\)")
RE_HOOK_FAIL = re.compile(
    r"pam_exec\(([A-Za-z0-9_.-]{1,32}):session\): \S*(?:timeout|auto-sec-login-hook) failed: "
    r"(exit code [0-9]{1,3}|caught signal [0-9]{1,3}.{0,20})")
RE_ROOT_LOGIN = re.compile(r"ROOT LOGIN\s+(?:on|ON) '?([^' ]{1,100})'?(?: (?:from|FROM) '?([^' ]{1,200})'?)?")
RE_LOGIN_ON = re.compile(r"LOGIN ON (\S{1,100}) BY (\S{1,100})(?: FROM (\S{1,200}))?")
RE_LOGGED_IN = re.compile(r"'(\S{1,100})' logged in\s+on '([^' ]{1,100})'(?: from '([^' ]{1,200})')?")
RE_SU = re.compile(r"\(to (\S{1,100})\) (\S{1,100}) on (\S{1,100})")
RE_WEB = re.compile(r"Successful login as (\S{1,100}) from (\S{1,200})")
RE_SUDO_HEAD = re.compile(r"\s*(\S{1,100}) : +(?:TTY=(\S{1,100}) ; )?(?:CHROOT=\S{0,200} ; )?PWD=")


def P(path):
