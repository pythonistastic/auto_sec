#!/usr/bin/env bash
# Ransomware early warning: if the file modification rate in the app dir
# exceeds a threshold, alert immediately (encryption sweeps touch hundreds
# of files per minute).
#
# SECURITY: credentials and the watched path are read at runtime from
# root-only files rather than interpolated into shell source - $(...) and
# backticks expand inside double quotes, so a crafted value would execute as
# root under a systemd unit with Restart=always.
#
# ROBUSTNESS: inotifywait is wrapped so that a missing directory or an
# exhausted inotify watch limit cannot turn this into a busy-loop. Without
# the guard below, inotifywait exits instantly and `while true` spins a full
# CPU core forever on a production host.
set -uo pipefail

HOST_ID={{ inventory_hostname | quote }}
THRESHOLD={{ ransomware_canary_threshold | default(150) | int }}
INTERVAL={{ ransomware_canary_interval | default(60) | int }}

WATCH_DIR="$(cat /opt/detect/.canary_dir 2>/dev/null || true)"
TG_TOKEN="$(cat /opt/detect/.tg_token 2>/dev/null || true)"
TG_CHAT="$(cat /opt/detect/.tg_chat 2>/dev/null || true)"

notify() {
  [ -n "$TG_TOKEN" ] && [ "$TG_TOKEN" != "CHANGE_ME" ] || return 0
  curl -s -X POST "https://api.telegram.org/bot${TG_TOKEN}/sendMessage" \
    -d chat_id="${TG_CHAT}" --data-urlencode "text=$1" > /dev/null || true
}

log() { printf '[canary] %s\n' "$*" >&2; }

if [ -z "$WATCH_DIR" ]; then
  log "no watch directory configured; nothing to do"
  exit 0
fi

while true; do
  if [ ! -d "$WATCH_DIR" ]; then
    # Do not spin: wait and re-check. The directory may appear later (first
    # deploy), or may never exist on a host with no application.
    log "watch directory $WATCH_DIR does not exist; sleeping"
    sleep "$INTERVAL"
    continue
  fi

  START=$(date +%s)
  COUNT=$(timeout "$INTERVAL" inotifywait -r -q \
            -e modify,create,delete,move \
            --exclude '(node_modules|\.next|\.git|/tmp/)' \
            "$WATCH_DIR" 2>/dev/null | wc -l) || true
  ELAPSED=$(( $(date +%s) - START ))

  if [ "${COUNT:-0}" -gt "$THRESHOLD" ]; then
    notify "RANSOMWARE WARNING [${HOST_ID}]: ${COUNT} file events in ${INTERVAL}s under ${WATCH_DIR}. Possible encryption sweep in progress. Consider isolating the server NOW."
  fi

  # If inotifywait returned early (missing watches, hit the limit, error),
  # back off for the remainder of the interval instead of looping hot.
  if [ "$ELAPSED" -lt "$INTERVAL" ]; then
    sleep "$(( INTERVAL - ELAPSED ))"
  fi
done
