{#- SSH lines show EFFECTIVE values (sshd -T), never intent:
    _ssh_after   live values: role 02's preflight sets it to the values at
                 the start of the run, role 02 main updates it at its end;
    _ssh_before  preflight's view, used if _ssh_after is empty;
    neither      (preflight skipped): no SSH claim is made.
    Each is {admin: {...}, root: {...}} keyed by lowercase sshd -T keyword;
    a value may be a string or a list (keywords sshd prints more than once).
    "Hardened" uses the same rule as role 02's _ssh_hardened (root's
    permitrootlogin is not "yes", passwordauthentication is "no" for both
    the admin and root views), computed from the values shown, so the
    verdict always matches the values printed, whichever of the two facts
    they came from. -#}
{%- macro _sshd(view, key) -%}
{%- set _v = view[key] | default('') -%}
{%- if _v is string or _v is not iterable -%}{{ _v | string | trim }}{%- else -%}{{ _v | map('string') | join(' ') | trim }}{%- endif -%}
{%- endmacro -%}
{%- set _sa = _ssh_after | default({}, true) -%}
{%- set _sv = _sa if (_sa.admin | default({}, true) | length > 0) else (_ssh_before | default({}, true)) -%}
{%- set _sv_admin = _sv.admin | default({}, true) -%}
{%- set _sv_root = _sv.root | default(_sv_admin, true) -%}
{%- set _prl = _sshd(_sv_root, 'permitrootlogin') | lower -%}
{%- set _pwd = _sshd(_sv_admin, 'passwordauthentication') | lower -%}
{%- set _pwd_root = _sshd(_sv_root, 'passwordauthentication') | lower -%}
{%- set _kbd = _sshd(_sv_admin, 'kbdinteractiveauthentication') | lower -%}
{%- set _pub = _sshd(_sv_admin, 'pubkeyauthentication') | lower -%}
{%- set _users = _sshd(_sv_admin, 'allowusers').split() | join(', ') -%}
{%- set _ssh_known = _prl | length > 0 and _pwd | length > 0 -%}
{%- set _hard = _prl != 'yes' and _pwd == 'no' and _pwd_root == 'no' -%}
{%- set _why = (['root can log in with a password'] if _prl == 'yes' else [])
             + (['password login is enabled'] if (_pwd != 'no' or _pwd_root != 'no') else []) -%}
