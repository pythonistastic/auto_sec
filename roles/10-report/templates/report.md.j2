{#- SSH lines show EFFECTIVE values (sshd -T), never intent:
    _ssh_after   live values: role 02's preflight sets it to the values at
                 the start of the run, role 02 main updates it at its end;
    _ssh_before  preflight's view, used if _ssh_after is empty;
    neither      (preflight skipped): no SSH claim is made.
    Each is {admin: {...}, root: {...}} keyed by lowercase sshd -T keyword;
    a value may be a string or a list (keywords sshd prints more than once).
    "Hardened" uses the same rule as role 02's _ssh_hardened (root's
    permitrootlogin is not "yes", passwordauthentication is "no" for both
    the admin and root views), computed from the values shown, so the
    verdict always matches the values printed, whichever of the two facts
    they came from. -#}
{%- macro _sshd(view, key) -%}
{%- set _v = view[key] | default('') -%}
{%- if _v is string or _v is not iterable -%}{{ _v | string | trim }}{%- else -%}{{ _v | map('string') | join(' ') | trim }}{%- endif -%}
{%- endmacro -%}
{%- set _sa = _ssh_after | default({}, true) -%}
{%- set _sv = _sa if (_sa.admin | default({}, true) | length > 0) else (_ssh_before | default({}, true)) -%}
{%- set _sv_admin = _sv.admin | default({}, true) -%}
{%- set _sv_root = _sv.root | default(_sv_admin, true) -%}
{%- set _prl = _sshd(_sv_root, 'permitrootlogin') | lower -%}
{%- set _pwd = _sshd(_sv_admin, 'passwordauthentication') | lower -%}
{%- set _pwd_root = _sshd(_sv_root, 'passwordauthentication') | lower -%}
{%- set _kbd = _sshd(_sv_admin, 'kbdinteractiveauthentication') | lower -%}
{%- set _pub = _sshd(_sv_admin, 'pubkeyauthentication') | lower -%}
{%- set _users = _sshd(_sv_admin, 'allowusers').split() | join(', ') -%}
{%- set _ssh_known = _prl | length > 0 and _pwd | length > 0 -%}
{%- set _hard = _prl != 'yes' and _pwd == 'no' and _pwd_root == 'no' -%}
{%- set _why = (['root can log in with a password'] if _prl == 'yes' else [])
             + (['password login is enabled'] if (_pwd != 'no' or _pwd_root != 'no') else []) -%}
{#- Update lines show what apt uses, read during this run (never intent):
    _base_uu_after   role 01's check after its change (role 01 ran);
    _base_uu_before  role 01's preflight, at the start of the run;
    neither          (preflight skipped): no claim is made.
    Role 01's parser has already replaced every brace in these host values.
    _base_tz_after is the timezone after role 01 (it matched a strict
    pattern); '' when unknown. -#}
{%- set _uu = _base_uu_after | default({}, true) -%}
{%- set _uu = _uu if (_uu | length > 0) else (_base_uu_before | default({}, true)) -%}
{%- set _uu_known = _base_uu_before is defined -%}
{%- set _uu_inst = (_base_uu_installed | default(false) | bool)
                   or ((_base_uu_after | default({}, true) | length > 0) and (_base_uu_install | default(false) | bool)) -%}
{%- set _uu_on = _uu_inst
                 and (_uu['APT::Periodic::Unattended-Upgrade'] | default(['']) | last) not in ['0', '']
                 and (_uu['APT::Periodic::Update-Package-Lists'] | default(['']) | last) not in ['0', '']
                 and (_uu['APT::Periodic::Enable'] | default(['1']) | last) != '0' -%}
{%- set _uu_timer_off = (_base_uu_timer | default('')) not in ['', 'enabled', 'static', 'indirect', 'alias'] -%}
{%- set _rb_on = (_uu['Unattended-Upgrade::Automatic-Reboot'] | default(['']) | last | lower) in ['1', 'yes', 'true', 'with', 'on', 'enable'] -%}
{%- set _rb_time = _uu['Unattended-Upgrade::Automatic-Reboot-Time'] | default(['now']) | last -%}
{%- set _tz = _base_tz_after | default('', true) -%}
{%- set _tz_txt = (' ' ~ _tz) if (_tz | length > 0) else ' (server time)' -%}
{#- Header lines without a value are left out: client_name, client_domain
    and report_prepared_by are optional ("Your Company" is the unfilled
    placeholder). -#}
{%- set _by = report_prepared_by | default('') | string | trim -%}
{%- set _by = '' if _by == 'Your Company' else _by -%}
{%- set _date = (ansible_facts['date_time']['date'] | default('')) if (ansible_facts['date_time'] is defined) else '' -%}
{%- set _date = _date or now(utc=true, fmt='%Y-%m-%d') -%}
