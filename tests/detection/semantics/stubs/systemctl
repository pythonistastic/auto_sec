#!/bin/sh
# LAB stub for systemctl (tests/detection/semantics/test_role.py). It stands
# in for systemd in three places: role 08's own calls (_det_systemctl), the
# `systemctl` that the role's sh scripts find in PATH, and <lab>/stub, where
# `auto-sec-detect --root <lab>` looks for it.
#   $LAB_SD/calls        every call, one per line
#   $LAB_SD/unit.<name>  the state of a unit ("active"); no file = inactive
#   $LAB_SD/pending      when it exists: the units with edits systemd has
#                        not loaded, one name per line (an empty file:
#                        lab-edited.service). For R08-5
#   $LAB_SENDER          the command of the real sender against the lab root.
#                        `start auto-sec-alert.service` runs it in the
#                        background (pid in $LAB_SD/sender.pid, output in
#                        $LAB_SD/sender.log); restart and stop end it first
#   $LAB_BEATS           the lab's state folder. No journal reader runs in
#                        the lab: its heartbeat file is touched when the unit
#                        is started and each time it is asked for while active
#   $LAB_ON_SHOW         a command run at every `show` (a file that changes
#                        between the plan and the apply phase, for M08-1)
d=${LAB_SD:?}
printf '%s\n' "$*" >> "$d/calls"
cmd=${1-}
[ $# -gt 0 ] && shift
state() { if [ -f "$d/unit.$1" ]; then cat "$d/unit.$1"; else echo inactive; fi; }
pending() { if [ -s "$d/pending" ]; then cat "$d/pending"; elif [ -e "$d/pending" ]; then echo lab-edited.service; fi; }
stop_sender() {
  [ -f "$d/sender.pid" ] || return 0
  pid=$(cat "$d/sender.pid")
  kill "$pid" 2>/dev/null
  i=0
  while [ -d "/proc/$pid" ] && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
  rm -f "$d/sender.pid"
}
start_sender() {
  stop_sender
  # shellcheck disable=SC2086  # a command line, split on purpose
  nohup ${LAB_SENDER:?} >> "$d/sender.log" 2>&1 < /dev/null &
  echo $! > "$d/sender.pid"
}
case $cmd in
  show)
    units=
    for a in "$@"; do
      case $a in -p | Id | ActiveState | Id,NeedDaemonReload | --) ;; -*) ;; *) units="$units $a" ;; esac
    done
    for u in $units; do
      echo "Id=$u"
      echo "ActiveState=$(state "$u")"
      if pending | grep -qxF -- "$u"; then echo "NeedDaemonReload=yes"; else echo "NeedDaemonReload=no"; fi
      echo
    done
    if [ -n "${LAB_ON_SHOW:-}" ]; then sh -c "$LAB_ON_SHOW"; fi ;;
  list-units)
    pending | while IFS= read -r u; do echo "$u loaded active running a unit with edits"; done ;;
  is-active)
    st=$(state "${1-}")
    if [ "$st" = active ] && [ "${1-}" = auto-sec-login-watch.service ]; then touch "${LAB_BEATS:?}/watch.alive"; fi
    echo "$st"
    [ "$st" = active ] ;;
  is-system-running) echo running ;;
  start | restart)
    for u in "$@"; do
      echo active > "$d/unit.$u"
      case $u in
        auto-sec-alert.service) start_sender ;;
        auto-sec-login-watch.service) touch "${LAB_BEATS:?}/watch.alive" ;;
      esac
    done ;;
  stop)
    for u in "$@"; do
      rm -f "$d/unit.$u"
      case $u in auto-sec-alert.service) stop_sender ;; esac
    done ;;
  daemon-reload | reset-failed) ;;
  *) exit 1 ;;
esac
