{
  "autosec_server": "new",
  "autosec_require_approval": true,
  "_base_role_runs": true,
  "_ssh_role_runs": true,
  "_ssh_enabled": true,
  "_fw_role_runs": true,
  "_f2b_role_runs": true,
  "_l08_role_runs": true,
  "_l09_role_runs": true,
  "_layer_04": false,
  "_layer_05": false,
